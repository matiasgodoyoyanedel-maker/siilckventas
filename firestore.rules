rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dueños del sitio (los mismos UID que usa el panel / publicaciones)
    function isOwner() {
      return signedIn() && (
        request.auth.uid == 'YwjfajkyMXMRHd18eII4dwV03NF3' ||
        request.auth.uid == 'w4JA6UUF7WeC6UJweKAKdWYMHf73'
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function perfilPrivilegedKeys() {
      return ['esVendedorVip', 'tipoVip', 'bloqueado', 'is_blocked', 'vipExpira', 'isVip', 'plan'];
    }

    // verificadoForzado solo puede quedar en true si Firebase Auth confirma el correo.
    function verificacionPermitida(anterior) {
      return request.resource.data.get('verificadoForzado', false) != true
        || anterior == true
        || request.auth.token.email_verified == true;
    }

    // --- Perfiles ---
    // Lectura pública: login (unicidad de username ANTES de autenticar),
    // marketplace, foro y panel admin (lista completa).
    match /perfiles/{userId} {
      allow read: if true;

      allow create: if isOwner() || (
        isSelf(userId) &&
        (!('esVendedorVip' in request.resource.data) || request.resource.data.esVendedorVip == false) &&
        (!('isVip' in request.resource.data) || request.resource.data.isVip == false) &&
        (!('bloqueado' in request.resource.data) || request.resource.data.bloqueado == false) &&
        (!('is_blocked' in request.resource.data) || request.resource.data.is_blocked == false) &&
        verificacionPermitida(false)
      );

      allow update: if isOwner() || (
        isSelf(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(perfilPrivilegedKeys()) &&
        verificacionPermitida(resource.data.get('verificadoForzado', false))
      );

      allow delete: if isOwner();
    }

    // --- Marketplace ---
    match /publicaciones/{pubId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.vendedorUid == request.auth.uid;

      allow update: if isOwner() || (
        signedIn()
        && resource.data.vendedorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impulsadoEn'])
      );

      allow delete: if isOwner()
        || (signedIn() && resource.data.vendedorUid == request.auth.uid);
    }

    // Credenciales de cuentas en venta (solo dueño o el vendedor)
    match /cuentas_secretas/{secretId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.vendedorUid == request.auth.uid);

      allow create: if isOwner()
        || (signedIn() && request.resource.data.vendedorUid == request.auth.uid);

      allow update, delete: if isOwner()
        || (signedIn() && resource.data.vendedorUid == request.auth.uid);
    }

    // --- Carrito ---
    match /carritos/{uid} {
      allow read, write: if isSelf(uid);

      match /items/{itemId} {
        allow read, write: if isSelf(uid);
      }
    }

    // --- Chats P2P ---
    match /chats_p2p/{chatId} {
      function chatDoc() {
        return get(/databases/$(database)/documents/chats_p2p/$(chatId)).data;
      }

      function isChatPartyFrom(data) {
        return signedIn() && (
          data.compradorUid == request.auth.uid ||
          data.vendedorUid == request.auth.uid
        );
      }

      function isChatParty() {
        return isOwner() || isChatPartyFrom(chatDoc());
      }

      allow read: if isOwner() || isChatPartyFrom(resource.data);

      allow create: if signedIn()
        && request.resource.data.compradorUid == request.auth.uid
        && request.resource.data.vendedorUid is string
        && request.resource.data.compradorUid != request.resource.data.vendedorUid;

      allow update: if isOwner() || (
        isChatPartyFrom(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['compradorUid', 'vendedorUid'])
      );

      allow delete: if isOwner();

      match /mensajes/{msgId} {
        allow read: if isChatParty();

        allow create: if isChatParty()
          && request.resource.data.remitenteUid == request.auth.uid;

        allow update, delete: if isOwner();
      }
    }

    // --- Tickets de soporte ---
    match /tickets/{ticketId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isOwner();
    }

    // --- Postulaciones (carnet / selfie: solo admin o el postulante) ---
    match /postulaciones_vendedores/{postId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente_revision';

      allow update, delete: if isOwner();
    }

    // --- Partners SK (postulaciones mayoristas) ---
    match /partners_sk/{partnerId} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(
          ['nombre', 'instagram', 'ciudad', 'telefono', 'mensaje', 'aceptoTerminos', 'estado', 'fecha'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 120
        && request.resource.data.instagram is string && request.resource.data.instagram.size() > 0 && request.resource.data.instagram.size() <= 120
        && request.resource.data.ciudad is string && request.resource.data.ciudad.size() > 0 && request.resource.data.ciudad.size() <= 120
        && request.resource.data.telefono is string && request.resource.data.telefono.size() > 0 && request.resource.data.telefono.size() <= 40
        && (!('mensaje' in request.resource.data) || (request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 2000))
        && request.resource.data.aceptoTerminos == true
        && request.resource.data.estado == 'pendiente_revision'
        && request.resource.data.fecha == request.time;
      allow update, delete: if isOwner();
    }

    // --- Configuración global (tema, mantención, avisos, WhatsApp) ---
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /recentActivity/{actId} {
      allow read: if true;
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    // --- Órdenes, ventas y entregas automáticas (escribe el servidor / Admin SDK) ---
    match /ordenes/{ordenId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.compradorUid == request.auth.uid);
      allow write: if false;
    }

    match /ventas/{ventaId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.compradorUid == request.auth.uid);
      allow write: if false;
    }

    match /entregas/{entregaId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.compradorUid == request.auth.uid);
      allow write: if false;
    }

    // Credenciales copiadas al crear la orden. El comprador solo las lee si el pago ya está marcado.
    match /compras_privadas/{ordenId} {
      allow read: if isOwner() || (
        signedIn()
        && resource.data.compradorUid == request.auth.uid
        && resource.data.pagado == true
      );
      allow write: if false;
    }

    // --- Reputación, saldo, reseñas y reclamos ---
    match /reputacion/{vendedorUid} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /resenas/{ordenId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /saldos/{uid} {
      allow read: if isOwner() || isSelf(uid);
      allow write: if isOwner();
    }

    match /movimientos_saldo/{movId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.vendedorUid == request.auth.uid);
      allow write: if isOwner();
    }

    match /retiros/{retiroId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.vendedorUid == request.auth.uid);
      allow create: if false;
      allow update, delete: if isOwner();
    }

    match /reclamos/{ordenId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.compradorUid == request.auth.uid);
      allow write: if isOwner();
    }

    // --- Foro ---
    match /foros/{foroId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.autorUid == request.auth.uid;

      allow update: if isOwner() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && soloMiLike(resource.data.get('likes', []).toSet(), request.resource.data.likes.toSet())
      );

      // Cada usuario solo puede agregar o quitar su propio UID del arreglo de likes.
      function soloMiLike(antes, despues) {
        return despues.difference(antes) == [request.auth.uid].toSet() && antes.difference(despues).size() == 0
          || antes.difference(despues) == [request.auth.uid].toSet() && despues.difference(antes).size() == 0;
      }

      allow delete: if isOwner()
        || (signedIn() && resource.data.autorUid == request.auth.uid);
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
