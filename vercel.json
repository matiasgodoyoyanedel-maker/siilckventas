{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{index.html,cuenta.html}"
    }
  },
  "redirects": [
    { "source": "/verificar-correo", "destination": "/login?vista=verificar", "permanent": false },
    { "source": "/verificar-correo/", "destination": "/login?vista=verificar", "permanent": false },
    { "source": "/vendedor/:uid", "destination": "/vendedor?uid=:uid", "permanent": false },
    { "source": "/vendedor/:uid/", "destination": "/vendedor?uid=:uid", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/google78561bbab4dd18b7.html", "destination": "/api/google-verify" },
    { "source": "/google78561bbab4dd18b7", "destination": "/api/google-verify" },
    { "source": "/pago/exito", "destination": "/pago/exito.html" },
    { "source": "/pago/error", "destination": "/pago/error.html" },
    { "source": "/mis-compras/:id", "destination": "/mis-compras.html" },
    { "source": "/cuenta/:id", "destination": "/api/cuenta-pagina?id=:id" },
    { "source": "/cuenta/:id/", "destination": "/api/cuenta-pagina?id=:id" },
    { "source": "/vendedor/:uid", "destination": "/vendedor.html?uid=:uid" },
    { "source": "/verificar-correo", "destination": "/login.html" },
    { "source": "/mantenimiento", "destination": "/api/mantenimiento" },
    { "source": "/partners-sk", "destination": "/partners-sk.html" }
  ],
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": ["/google78561bbab4dd18b7.html", "/google78561bbab4dd18b7"]
  },
  "crons": [
    { "path": "/api/limpiar-vendidas", "schedule": "0 5 * * *" }
  ]
}
